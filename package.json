{
    "name": "@dev-md/ts-log",
    "version": "1.0.0",
    "description": "A TypeScript logging utility.",
    "keywords": [],
    "homepage": "https://github.com/iLiftALot/ts-log#README",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/iLiftALot/ts-log.git"
    },
    "license": "MIT",
    "author": "Nicholas Corbin",
    "type": "commonjs",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsx src/main.ts",
        "build": "tsc",
        "start": "node --enable-source-maps dist/main.js",
        "typecheck:logger": "tsc -p tsconfig.logger.json",
        "test:logger": "tsx --test test/*test.ts",
        "fmt": "zsh scripts/fmt.sh",
        "fmt:check": "zsh scripts/fmt.sh check",
        "fmt:output": "zsh scripts/fmt.sh file-paths",
        "prepare": "npm run build",
        "release:manual": "npm publish --access public"
    },
    "dependencies": {
        "@js-temporal/polyfill": "0.5.1",
        "dotenv": "17.4.2"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "tsx": "4.23.15",
        "typescript": "6.0.3"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true
    }
}